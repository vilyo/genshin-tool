# macOS
.DS_Store

# Node / 前端
node_modules/
dist/

# Tauri / Rust
src-tauri/target/

# 本地环境与日志
*.local
*.log

# 环境变量与密钥(个人配置,严禁入库)
.env
.env.*
!.env.example
*.pem
*.key

# IDE 个人配置
.idea/
.vscode/

# 本地运行数据（数据库 / 备份导出），只存在于用户数据目录，严禁入库
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
genshintool-backup-*.json

# 测试夹具样本日志为合成数据、被 Rust 编译期 include_str!/include_bytes! 引用，必须入库
!src-tauri/src/probe/fixtures/*.log

# 字体裁剪源(约 25MB 完整字体,仅本地供 scripts/make-font.py 裁剪;产物 LXGWWenKaiNum.ttf 入库)
src/assets/fonts/LXGWWenKai-Regular.ttf

# 开发文档（仅本地保留，不入公开仓库；例外：docs/prototype/ 为 M2 定稿设计产物，入库）
/docs/*
!/docs/prototype/
/.scratch/
/AGENTS.md
/CONTEXT.md

# ZCode 本地会话数据(工具自建,不入库)
/.zcode/
