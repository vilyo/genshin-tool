{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "原神工具箱",
  "mainBinaryName": "genshintool",
  "version": "0.1.0",
  "identifier": "com.vilyo.genshintool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "原神工具箱",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
